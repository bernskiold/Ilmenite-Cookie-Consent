<?xml version="1.0"?>
<ruleset name="Ilmenite Cookie Consent">
	<description>PHP compatibility checks for the plugin's supported PHP and WordPress versions.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!-- Keep in sync with "Requires PHP" in readme.txt and composer.json. -->
	<config name="testVersion" value="7.2-"/>
	<!-- Keep in sync with "Requires at least" in readme.txt. -->
	<config name="minimum_supported_wp_version" value="5.0"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
